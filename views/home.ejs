<!DOCTYPE html>
<html lang="es">
<head>
    <%- include("partials/head", { title }) %>
</head>
<body>
    <%- include("partials/nav", { active: "home" }) %>

    <main>
        <section class="container hero">
            <div class="hero-copy">
                <span class="eyebrow">Laboratorio Semana 04</span>
                <h1>Aplicaciones web que conectan <span>ideas y personas</span></h1>
                <p class="lead">Una experiencia construida con Express, vistas dinámicas en EJS y componentes Materialize, organizada para crecer con claridad.</p>
                <div class="hero-actions">
                    <a href="/games" class="waves-effect waves-light btn-large">Explorar registros<i class="material-icons right">arrow_forward</i></a>
                    <a href="/contact" class="waves-effect btn-large btn-secondary">Enviar mensaje</a>
                </div>
            </div>

            <div class="hero-visual" aria-label="Resumen de funcionalidades">
                <div class="window-bar"><span class="window-dot"></span><span class="window-dot"></span><span class="window-dot"></span></div>
                <div class="metric-grid">
                    <div class="metric-card highlight">
                        <i class="material-icons">hub</i>
                        <strong>Arquitectura organizada</strong>
                        <span>Rutas, controladores y vistas conectados con una estructura clara.</span>
                    </div>
                    <div class="metric-card">
                        <i class="material-icons">dynamic_form</i>
                        <strong>Formularios</strong>
                        <span>Datos procesados en el servidor.</span>
                    </div>
                    <div class="metric-card">
                        <i class="material-icons">devices</i>
                        <strong>Responsive</strong>
                        <span>Diseño adaptable y accesible.</span>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <%- include("partials/footer") %>
</body>
</html>
