<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <nav class="blue darken-3">
        <div class="nav-wrapper container">
            <a href="/" class="brand-logo">Semana 04</a>
            <ul class="right">
                <li><a href="/">Inicio</a></li>
                <li><a href="/about">Acerca de</a></li>
                <li><a href="/admin">Admin</a></li>
                <li><a href="/games">Videojuegos</a></li>
            </ul>
        </div>
    </nav>

    <main class="container page-content">
        <div class="card-panel">
            <h1 class="center-align">Formulario de Contacto</h1>
            <form action="/contact" method="POST">
                <div class="input-field">
                    <i class="material-icons prefix">person</i>
                    <input id="nombre" type="text" name="nombre" required>
                    <label for="nombre">Nombre</label>
                </div>
                <div class="input-field">
                    <i class="material-icons prefix">email</i>
                    <input id="email" type="email" name="email" required>
                    <label for="email">Correo electrónico</label>
                </div>
                <div class="input-field">
                    <i class="material-icons prefix">message</i>
                    <textarea id="mensaje" class="materialize-textarea" name="mensaje" required></textarea>
                    <label for="mensaje">Mensaje</label>
                </div>
                <div class="actions">
                    <button type="submit" class="waves-effect waves-light btn blue darken-3">
                        <i class="material-icons right">send</i>Enviar
                    </button>
                    <a href="/" class="waves-effect waves-light btn grey darken-2">Volver</a>
                </div>
            </form>
        </div>
    </main>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
</body>
</html>
