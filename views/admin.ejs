<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <nav class="blue darken-3">
        <div class="nav-wrapper container">
            <a href="/" class="brand-logo">Semana 04</a>
            <ul class="right">
                <li><a href="/">Inicio</a></li>
                <li><a href="/about">Acerca de</a></li>
                <li><a href="/contact">Contacto</a></li>
                <li><a href="/games">Videojuegos</a></li>
            </ul>
        </div>
    </nav>

    <main class="container page-content">
        <h1 class="center-align">Mensajes recibidos</h1>
        <div class="actions">
            <a href="/contact" class="waves-effect waves-light btn blue darken-3">
                <i class="material-icons left">add</i>Nuevo mensaje
            </a>
        </div>

        <% if (messages.length === 0) { %>
            <div class="card-panel empty-state">No hay mensajes aún.</div>
        <% } else { %>
            <ul class="collection">
                <% messages.forEach(message => { %>
                    <li class="collection-item avatar">
                        <i class="material-icons circle blue darken-3">email</i>
                        <span class="title"><strong><%= message.nombre %></strong></span>
                        <p><%= message.email %><br><%= message.mensaje %></p>
                    </li>
                <% }) %>
            </ul>
        <% } %>
    </main>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
</body>
</html>
