<!DOCTYPE html>
<html lang="es">
<head>
    <%- include("partials/head", { title }) %>
</head>
<body>
    <%- include("partials/nav", { active: "admin" }) %>

    <main class="container page-content">
        <header class="section-header">
            <div>
                <span class="eyebrow">Panel de administración</span>
                <h1>Mensajes recibidos</h1>
                <p class="lead"><%= messages.length %> <%= messages.length === 1 ? "mensaje disponible" : "mensajes disponibles" %> durante esta sesión.</p>
            </div>
            <a href="/contact" class="waves-effect waves-light btn-large">Nuevo mensaje<i class="material-icons right">add</i></a>
        </header>

        <% if (messages.length === 0) { %>
            <section class="surface empty-state">
                <i class="material-icons">mark_email_unread</i>
                <h2>Tu bandeja está vacía</h2>
                <p>Aún no se han recibido mensajes desde el formulario de contacto.</p>
            </section>
        <% } else { %>
            <section class="message-list" aria-label="Lista de mensajes">
                <% messages.forEach((message, index) => { %>
                    <article class="surface message-card">
                        <span class="avatar-icon"><i class="material-icons">mail_outline</i></span>
                        <div>
                            <h3><%= message.nombre %></h3>
                            <a href="mailto:<%= message.email %>"><%= message.email %></a>
                            <p><%= message.mensaje %></p>
                        </div>
                        <span class="message-number">#<%= String(index + 1).padStart(2, "0") %></span>
                    </article>
                <% }) %>
            </section>
        <% } %>
    </main>

    <%- include("partials/footer") %>
</body>
</html>
