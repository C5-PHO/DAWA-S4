<!DOCTYPE html>
<html lang="es">
<head>
    <%- include("partials/head", { title }) %>
</head>
<body>
    <%- include("partials/nav", { active: "games" }) %>

    <main class="container page-content">
        <header class="section-header">
            <div>
                <span class="eyebrow">Colección interactiva</span>
                <h1>Videojuegos populares</h1>
                <p class="lead">Registra títulos destacados y consulta la colección almacenada durante la sesión.</p>
            </div>
        </header>

        <section class="games-layout">
            <div class="card">
                <div class="card-content">
                    <span class="card-title">Agregar videojuego</span>
                    <form action="/games" method="POST">
                        <div class="input-field"><input id="nombre" type="text" name="nombre" required><label for="nombre">Nombre del videojuego</label></div>
                        <div class="input-field"><input id="genero" type="text" name="genero" required><label for="genero">Género</label></div>
                        <div class="input-field"><input id="plataforma" type="text" name="plataforma" required><label for="plataforma">Plataforma</label></div>
                        <div class="row">
                            <div class="input-field col s6"><input id="lanzamiento" type="number" name="lanzamiento" min="1950" max="2100" required><label for="lanzamiento">Año</label></div>
                            <div class="input-field col s6"><input id="puntuacion" type="number" name="puntuacion" min="1" max="10" step="0.1" required><label for="puntuacion">Puntuación</label></div>
                        </div>
                        <button type="submit" class="waves-effect waves-light btn-large">Guardar registro<i class="material-icons right">add_circle_outline</i></button>
                    </form>
                </div>
            </div>

            <div class="card">
                <div class="card-content">
                    <span class="card-title">Colección · <%= games.length %> registros</span>
                    <div class="table-wrap">
                        <table>
                            <thead><tr><th>Nombre</th><th>Género</th><th>Plataforma</th><th>Año</th><th>Puntuación</th></tr></thead>
                            <tbody>
                                <% games.forEach(game => { %>
                                    <tr>
                                        <td><strong><%= game.nombre %></strong></td>
                                        <td><%= game.genero %></td>
                                        <td><%= game.plataforma %></td>
                                        <td><%= game.lanzamiento %></td>
                                        <td><span class="score-pill"><%= game.puntuacion %> / 10</span></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <%- include("partials/footer") %>
</body>
</html>
