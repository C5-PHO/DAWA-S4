<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <nav class="blue darken-3">
        <div class="nav-wrapper container">
            <a href="/" class="brand-logo">Semana 04</a>
            <ul class="right">
                <li><a href="/">Inicio</a></li>
                <li><a href="/about">Acerca de</a></li>
                <li><a href="/contact">Contacto</a></li>
                <li><a href="/admin">Admin</a></li>
            </ul>
        </div>
    </nav>

    <main class="container page-content">
        <h1 class="center-align">Videojuegos Populares</h1>

        <div class="card">
            <div class="card-content">
                <span class="card-title">Agregar un videojuego</span>
                <form action="/games" method="POST">
                    <div class="row">
                        <div class="input-field col s12 m6">
                            <input id="nombre" type="text" name="nombre" required>
                            <label for="nombre">Nombre</label>
                        </div>
                        <div class="input-field col s12 m6">
                            <input id="genero" type="text" name="genero" required>
                            <label for="genero">Género</label>
                        </div>
                        <div class="input-field col s12 m6">
                            <input id="plataforma" type="text" name="plataforma" required>
                            <label for="plataforma">Plataforma</label>
                        </div>
                        <div class="input-field col s12 m3">
                            <input id="lanzamiento" type="number" name="lanzamiento" min="1950" max="2100" required>
                            <label for="lanzamiento">Año</label>
                        </div>
                        <div class="input-field col s12 m3">
                            <input id="puntuacion" type="number" name="puntuacion" min="1" max="10" step="0.1" required>
                            <label for="puntuacion">Puntuación</label>
                        </div>
                    </div>
                    <button type="submit" class="waves-effect waves-light btn blue darken-3">
                        <i class="material-icons right">save</i>Guardar
                    </button>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-content">
                <span class="card-title">Registros guardados</span>
                <div class="responsive-table">
                    <table class="striped highlight responsive-table">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Género</th>
                                <th>Plataforma</th>
                                <th>Año</th>
                                <th>Puntuación</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% games.forEach(game => { %>
                                <tr>
                                    <td><%= game.nombre %></td>
                                    <td><%= game.genero %></td>
                                    <td><%= game.plataforma %></td>
                                    <td><%= game.lanzamiento %></td>
                                    <td><%= game.puntuacion %>/10</td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
</body>
</html>
